{
  "name": "avansilp",
  "account_id": "30439c32c9bf66da23eaf4023cfd7d54",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker.mjs",
  "build": { "command": "npm run build" },
  "ratelimits": [
    { "name": "LP_LEAD_LIMIT", "namespace_id": "491284", "simple": { "limit": 8, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/leads", "/assets/*.mp4"]
  }
}
